# Hari-Saurabh Hostel Management System - Frontend Environment Config

# Backend API URL (Points to Render deployment in production or localhost for local dev)
# Example Render URL: https://hari-saurabh-backend.onrender.com/api
VITE_API_BASE_URL=https://hari-saurabh-backend.onrender.com/api

# Supabase Public Keys (Optional if connecting directly to Supabase from frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Mock fallback mode: set to false when backend is active on Render, true for demo/offline preview
VITE_USE_MOCK_FALLBACK=true
